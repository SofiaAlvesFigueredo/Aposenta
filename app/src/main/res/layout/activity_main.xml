<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/bgbackground"
    tools:context=".MainActivity">

    <!--
        Atributos do TextInputLayout solicitados:
        - app:helperText: Define a mensagem de apoio/ajuda exibida abaixo do campo de entrada.
        - app:helperTextTextColor: Define a cor do texto da mensagem de apoio.
        - app:counterEnabled: Ativa a exibição do contador visual de caracteres no canto inferior direito.
        - app:counterMaxLength: Define o limite máximo de caracteres exibido no contador.
        - app:endIconMode: Define a funcionalidade do ícone ao final do campo (ex: "clear_text" adiciona um botão para apagar o texto digitado).
    -->

    <Spinner
        android:id="@+id/Genero"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:entries="@array/opcoes_genero"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilIdade"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/hint_idade"
        app:startIconDrawable="@drawable/calculate"
        app:helperText="@string/helper_requerido"
        app:helperTextTextColor="@color/red"
        app:counterEnabled="true"
        app:counterMaxLength="3"
        app:endIconMode="clear_text"
        app:layout_constraintTop_toBottomOf="@id/Genero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIdade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:fontFamily="@font/funland" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="12dp"
        android:text="@string/btn_calcular"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:fontFamily="@font/funland"
        android:backgroundTint="@color/cor_botao"
        android:drawableStart="@drawable/hourglass"
        android:drawablePadding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tilIdade"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/Resultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textAlignment="center"
        android:textColor="@color/texto_principal"
        android:textSize="18sp"
        android:fontFamily="@font/funland"
        tools:text="Resultado aqui"
        app:layout_constraintTop_toBottomOf="@id/btnCalcular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/NomeAluno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/nome_aluno"
        android:textAlignment="center"
        android:textColor="@color/texto_principal"
        android:textSize="14sp"
        android:fontFamily="@font/funland"
        app:layout_constraintTop_toBottomOf="@id/Resultado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>